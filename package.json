{
	"name": "@kaishin/pi-usage",
	"version": "2.2.0",
	"license": "MIT",
	"type": "module",
	"private": false,
	"author": "Reda Lemeden",
	"description": "Pi extension that surfaces per-provider token-usage and quota status in the footer, plus a /usage command and dashboard. Restored from pi-quotas with MiniMax support.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"usage",
		"quota",
		"footer"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kaishin/pi-usage.git"
	},
	"pi": {
		"extensions": [
			"./src/extensions/core/index.ts",
			"./src/extensions/command-quotas/index.ts",
			"./src/extensions/command-tokens/index.ts",
			"./src/extensions/usage-status/index.ts",
			"./src/extensions/token-status/index.ts",
			"./src/extensions/quota-warnings/index.ts"
		]
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		}
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.85.1",
		"@earendil-works/pi-tui": "^0.85.1",
		"@types/node": "22.19.19",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"scripts": {
		"check": "tsc --noEmit",
		"typecheck": "tsc --noEmit",
		"test": "vitest --run",
		"test:watch": "vitest"
	}
}
